# Google Maps API — Street View & satellite imagery
# Get your key at: https://console.cloud.google.com/apis/credentials
# Required APIs: Maps Static API, Street View Static API
GOOGLE_MAPS_API_KEY=

# Google Gemini API (optional — users provide their own key via the UI)
# Only needed as a server-side fallback. Get one at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here

# US Census Bureau API — income / demographic data for the agent
# Get your free key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# HUD User API — Fair Market Rent data for the agent
# Register at: https://www.huduser.gov/hudapi/public/register
HUD_API_TOKEN=

# LA Open Data (Socrata SODA API) — optional app token for higher rate limits
# Get your free app token at: https://data.lacity.org/profile/edit/developer_settings
# SOCRATA_APP_TOKEN=

# Auth0 — Secure AI agent access (Auth0 for AI Agents)
# 1. Sign up at https://auth0.com (free tier, no credit card)
# 2. Create a "Regular Web Application"
# 3. Set Allowed Callback URLs: http://localhost:3000/auth/callback
# 4. Set Allowed Logout URLs: http://localhost:3000
AUTH0_SECRET=  # run: openssl rand -hex 32
AUTH0_DOMAIN=YOUR_DOMAIN.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
