# Optional — boosts geocoder accuracy. Falls back to Census geocoder if missing.
GOOGLE_MAPS_API_KEY=

# Optional — lifts Socrata rate limits.
SOCRATA_APP_TOKEN=

# Optional — Census ACS API key (free).
CENSUS_API_KEY=

# Optional — HUD FMR API token (free).
HUD_API_TOKEN=

# Required only for `pnpm eval` — used by the eval harness as the "agent under test".
GOOGLE_GENERATIVE_AI_API_KEY=

# HTTP transport port (only used by `pnpm http`).
MCP_HTTP_PORT=8787

# Cache directory (relative to mcp-server package root, override with abs path if needed).
SITESCOPE_CACHE_DIR=.cache
