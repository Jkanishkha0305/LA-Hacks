# Required — long random string. Determines your agent's stable address on Agentverse.
# DO NOT change this once you've registered on Agentverse, or your address will change.
AGENT_SEED=sitescope-la-hacks-2026-CHANGE-ME-to-something-unique

# Optional overrides
AGENT_NAME=sitescope
AGENT_PORT=8001

# URL of your running Next.js site-scope backend.
# - Local dev:  http://localhost:3000
# - Tunnel:     https://<your-ngrok-or-cloudflare-tunnel>.ngrok-free.app
SITE_SCOPE_URL=http://localhost:3000

# Optional — server-side fallback Gemini key forwarded to /api/agent as
# x-gemini-api-key. Leave blank if your apps/web/.env already has
# GOOGLE_GENERATIVE_AI_API_KEY set.
GEMINI_API_KEY=

# Per-request timeout in seconds (the agent does multi-step tool calls,
# leave generous).
HTTP_TIMEOUT=120
